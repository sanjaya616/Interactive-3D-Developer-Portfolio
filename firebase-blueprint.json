{
  "entities": {
    "UserCloudSave": {
      "title": "UserCloudSave",
      "description": "Cloud-synchronized save state for an authenticated player (no unnecessary PII such as email or phone).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the save owner."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Player display name for profile and leaderboard attribution."
        },
        "vehicle": {
          "type": "object",
          "description": "Customized vehicle configuration (chassis, paint, skin, wheels, accessory, plate, upgrade tiers)."
        },
        "settings": {
          "type": "object",
          "description": "User game preferences synced across sessions (quality, weather, audio volumes, accessibility)."
        },
        "visitedLocations": {
          "type": "array",
          "description": "Discovered 3D world landmark IDs."
        },
        "openedProjects": {
          "type": "array",
          "description": "Opened portfolio project slugs."
        },
        "collectedIds": {
          "type": "array",
          "description": "Collected world orbs, tokens, fragments, and relics."
        },
        "discoveredSecrets": {
          "type": "array",
          "description": "Discovered hidden world locations."
        },
        "completedChallenges": {
          "type": "array",
          "description": "Completed mini-challenge IDs."
        },
        "unlockedAchievements": {
          "type": "array",
          "description": "Unlocked achievement IDs."
        },
        "bestLapSeconds": {
          "type": "number",
          "description": "Player best Paddock lap time in seconds, or null if none recorded."
        },
        "lastLapSeconds": {
          "type": "number",
          "description": "Player most recent Paddock lap time in seconds, or null."
        },
        "distanceDrivenMeters": {
          "type": "number",
          "description": "Cumulative driven distance in meters."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable creation timestamp set via server request.time."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp set via server request.time."
        }
      },
      "required": [
        "uid",
        "displayName",
        "vehicle",
        "settings",
        "visitedLocations",
        "openedProjects",
        "collectedIds",
        "discoveredSecrets",
        "completedChallenges",
        "unlockedAchievements",
        "distanceDrivenMeters",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaderboardRecord": {
      "title": "LeaderboardRecord",
      "description": "Server-validated global Paddock Circuit best lap entry (one document per authenticated player UID).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "driverName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9 ._-]{2,24}$",
          "description": "Sanitized driver display name."
        },
        "vehicleType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "description": "Server-derived vehicle chassis and plate label."
        },
        "lapSeconds": {
          "type": "number",
          "description": "Server-verified Paddock Circuit lap duration in seconds (12.0 to 600.0)."
        },
        "runId": {
          "type": "string",
          "minLength": 8,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique single-use race run identifier issued by the verification server."
        },
        "serverSig": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "HMAC-SHA256 verification signature generated by the Express verification backend."
        },
        "status": {
          "type": "string",
          "enum": ["verified"],
          "description": "Verification status; only server-verified laps are published."
        },
        "achievedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the record was achieved (enforced to request.time)."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp (enforced to request.time)."
        }
      },
      "required": [
        "uid",
        "driverName",
        "vehicleType",
        "lapSeconds",
        "runId",
        "serverSig",
        "status",
        "achievedAt",
        "updatedAt"
      ]
    },
    "WhisperEntry": {
      "title": "WhisperEntry",
      "description": "Short moderated guestbook visitor message (maximum 30 characters).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Document identifier."
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Author Firebase Auth UID."
        },
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 24,
          "pattern": "^[a-zA-Z0-9 ._-]{2,24}$",
          "description": "Visitor chosen display name."
        },
        "countryCode": {
          "type": "string",
          "enum": ["LK", "US", "GB", "IN", "JP", "DE", "CA", "AU", "SG", "FR", "BR", "KR", "NL", "AE", "MY", "NZ", "SE", "CH", "ES", "GL"],
          "description": "Selected allowlisted ISO country flag code."
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Short visitor message strictly bounded to 30 characters."
        },
        "status": {
          "type": "string",
          "enum": ["published", "flagged", "removed"],
          "description": "Moderation visibility state."
        },
        "reportCount": {
          "type": "integer",
          "description": "Unique user abuse report counter."
        },
        "serverSig": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "HMAC-SHA256 spam/rate-limit approval token issued by Express moderation endpoint."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable creation timestamp set via request.time."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp set via request.time."
        }
      },
      "required": [
        "id",
        "authorUid",
        "authorName",
        "countryCode",
        "message",
        "status",
        "reportCount",
        "serverSig",
        "createdAt",
        "updatedAt"
      ]
    },
    "WhisperReport": {
      "title": "WhisperReport",
      "description": "Per-user abuse report record enforcing single report per user per Whisper.",
      "type": "object",
      "properties": {
        "whisperId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Target Whisper document ID."
        },
        "reporterUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Reporter Firebase Auth UID."
        },
        "reason": {
          "type": "string",
          "enum": ["spam", "offensive", "harassment", "other"],
          "description": "Categorized report reason."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the report."
        }
      },
      "required": ["whisperId", "reporterUid", "reason", "createdAt"]
    },
    "AdminRegistryEntry": {
      "title": "AdminRegistryEntry",
      "description": "Trusted administrator lookup document.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Admin UID."
        }
      },
      "required": ["uid"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserCloudSave" },
      "description": "Private owner-only cloud save profiles."
    },
    "/leaderboard/{uid}": {
      "schema": { "$ref": "#/entities/LeaderboardRecord" },
      "description": "Server-validated global Paddock racing leaderboard (one best record per player)."
    },
    "/whispers/{whisperId}": {
      "schema": { "$ref": "#/entities/WhisperEntry" },
      "description": "Public guestbook visitor messages (max 30 chars) with reporting and moderation."
    },
    "/whispers/{whisperId}/reports/{reporterUid}": {
      "schema": { "$ref": "#/entities/WhisperReport" },
      "description": "Unique per-user abuse reports linked atomically to parent whispers."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminRegistryEntry" },
      "description": "Admin role records."
    }
  }
}
